{"children":[{"data":"“One cat just leads to another.” —","type":"text"},{"children":[{"data":"Ernest Hemingway","type":"text"}],"name":"em","attribs":{},"type":"tag"}],"name":"li","attribs":{},"type":"tag"},{"children":[{"data":"“I had been told that the training procedure with cats was difficult. It’s not. Mine had me trained in two days.” —","type":"text"},{"children":[{"data":"Bill Dana","type":"text"}],"name":"em","attribs":{},"type":"tag"}],"name":"li","attribs":{},"type":"tag"},{"children":[{"data":"“What greater gift than the love of a cat?” —","type":"text"},{"children":[{"data":"Charles Dickens","type":"text"}],"name":"em","attribs":{},"type":"tag"}],"name":"li","attribs":{},"type":"tag"},{"children":[{"data":"“In ancient times, cats were worshiped as gods; they have not forgotten this.” –","type":"text"},{"children":[{"data":"Terry Pratchett","type":"text"}],"name":"em","attribs":{},"type":"tag"}],"name":"li","attribs":{},"type":"tag"},{"children":[{"data":"“Meow” means “woof” in cat.” —","type":"text"},{"children":[{"data":"George Carlin","type":"text"}],"name":"em","attribs":{},"type":"tag"}],"name":"li","attribs":{},"type":"tag"},{"children":[{"data":"“If cats could talk, they wouldn’t.” —","type":"text"},{"children":[{"data":"Nan Porter","type":"text"}],"name":"em","attribs":{},"type":"tag"}],"name":"li","attribs":{},"type":"tag"},{"children":[{"data":"“People who don’t like cats were probably mice in an earlier life.” —","type":"text"},{"children":[{"data":"Unknown ","type":"text"}],"name":"em","attribs":{},"type":"tag"},{"children":[],"name":"ul","attribs":{},"type":"tag"}],"name":"li","attribs":{},"type":"tag"}],"name":"ul","attribs":{},"type":"tag"}],"type":"root"},"embeddedContentProps":{},"embeddedMedia":{"content_attribute":{"bullets":4}},"hasContentProductLinks":false,"hasNutritionInfoInBody":false,"hasWatchNextInBodyTag":false,"pollCount":0,"products":{},"tableOfContents":{},"hideTableOfContentsTitle":false,"hasContentGate":false,"introductor